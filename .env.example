# Copie para .env e ajuste
KONTRUL_DATABASE_URL=postgresql+psycopg://kontrul:kontrul@localhost:5432/kontrul
KONTRUL_REDIS_URL=redis://localhost:6379/0
KONTRUL_DATA_DIR=./data
KONTRUL_API_TOKEN=dev-token-change-me
KONTRUL_PREVIEW_HEIGHT=720
KONTRUL_WHISPER_MODEL=large-v3
KONTRUL_WHISPER_LANGUAGE=pt
HF_TOKEN=

# Adaptador MCP (python -m app.mcp_server)
KONTRUL_API_URL=http://localhost:8000
# KONTRUL_API_TOKEN usa o mesmo valor acima
# Pastas de onde o agente pode enviar/salvar arquivos (separadas por ':'); padrão: home e diretório atual
# KONTRUL_MCP_ALLOWED_DIRS=/home/voce/Videos:/tmp

# ---- YouTube (opcional): botão "Buscar vídeos no YouTube" na aba Roteiro. Sem chave, mostra só links de busca.
# Chave da YouTube Data API v3 (Google Cloud Console > APIs > YouTube Data API v3 > Credenciais). Os termos de busca vão ao Google.
# KONTRUL_YOUTUBE_API_KEY=

# ---- LLM (opcional). Padrão: none = só regras; nada sai da máquina.
# Provedores: anthropic | openai | openrouter | ollama (local). Com API externa, o TEXTO da transcrição é enviado ao provedor.
KONTRUL_LLM_PROVIDER=none
# anthropic tem padrão (claude-sonnet-5-5); openai tem padrão gpt-4o-mini; openrouter e ollama exigem o modelo.
# Exemplos: openrouter -> anthropic/claude-sonnet-4.5 ; ollama -> llama3.1:8b
KONTRUL_LLM_MODEL=
# KONTRUL_LLM_BASE_URL=              # opcional: proxy / endpoint compatível com OpenAI
# KONTRUL_ANTHROPIC_API_KEY=
# KONTRUL_OPENAI_API_KEY=
# KONTRUL_OPENROUTER_API_KEY=
# KONTRUL_OLLAMA_HOST=http://localhost:11434   # no Docker o padrão é http://host.docker.internal:11434
# KONTRUL_LLM_MAX_WINDOWS=40         # teto de chamadas por análise (controle de custo)
# KONTRUL_LLM_WINDOW_WORDS=700       # palavras por janela enviada ao modelo
