resolver 127.0.0.11 valid=10s;

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 50g;          # uploads de vídeo grandes
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location /v1/ {
        set $upstream http://api:8000;
        proxy_pass $upstream;                      # sem URI: repassa o caminho original
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization "Bearer ${KONTRUL_API_TOKEN}";
        proxy_request_buffering off;               # upload em streaming, sem encher o disco do nginx
    }

    location ~ ^/health(/ready)?$ {
        set $upstream http://api:8000;
        proxy_pass $upstream;
    }

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
